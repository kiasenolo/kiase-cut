// Lens Distortion.002 [CompositorNodeLensdist]
vec4 f1_5_0(vec2 uv) {
    vec2 R = res();
    float gd = clamp(0.267033, -0.999, 1.0);
    float dsp = clamp(1.000000, 0.0, 1.0) / 4.0;
    vec3 d3 = vec3(clamp(gd + dsp, -0.999, 1.0), gd, clamp(gd - dsp, -0.999, 1.0));
    vec3 cd = d3 * 4.0;                                   // Blender's chromatic distortion (red, green, blue)
    float mxd = max(d3.x, max(d3.y, d3.z));
    float scl = (false && mxd > 0.0) ? 1.0 / (1.0 + 2.0 * mxd) : 1.0 / (1.0 + mxd);
    vec2 ctr = R / 2.0;
    vec2 tex = floor(uv * R);
    vec2 u2 = scl * (tex + 0.5 - ctr) / ctr;
    float d2 = dot(u2, u2);
    if (any(greaterThan(cd * d2, vec3(1.0))))
        return vec4(0.0);                                 // distorted past what is possible: nothing
    vec3 dsc = 1.0 / (1.0 + sqrt(max(vec3(0.0), 1.0 - cd * d2)));
    vec2 dr = (u2 * dsc.x + 0.5) * R, dg = (u2 * dsc.y + 0.5) * R, db = (u2 * dsc.z + 0.5) * R;
    float sr0 = distance(dr, dg), sb0 = distance(dg, db);        // (the pixels the red / blue are apart from the green)
    int sr = sr0 < 4.0 ? 2 : int(sqrt(sr0 + 1.0));
    int sb = sb0 < 4.0 ? 2 : int(sqrt(sb0 + 1.0));
    vec4 acc = vec4(0.0);
    {
        float amount = cd.g - cd.r;
        for (int i = 0; i < sr; i++) {
            float increment = (float(i) + hash_uint3_to_float(uint(tex.x), uint(tex.y), uint(0 * sr + i))) / float(sr);
            float ds = 1.0 / (1.0 + sqrt(max(0.0, 1.0 - (cd.r + increment * amount) * d2)));
            vec2 puv = u2 * ds + 0.5;
            vec2 smp_t = (puv) * R - 0.5;
            vec2 smp_i = floor(smp_t);
            vec2 smp_f = smp_t - smp_i;
